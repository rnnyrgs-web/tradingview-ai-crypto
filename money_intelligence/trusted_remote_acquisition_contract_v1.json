{
  "artifact_id": "PIT-TRUSTED-REMOTE-ACQUISITION-001-v1",
  "authority": "PROVENANCE_ONLY_NO_LABEL_FORECAST_PROMOTION_OR_TRADE_AUTHORITY",
  "forbidden": [
    "caller_supplied_response_digest_as_authority",
    "caller_supplied_historical_available_at_as_authority",
    "redirect_following",
    "non_main_execution",
    "non_workflow_dispatch_execution",
    "unattested_bundle_as_authority"
  ],
  "receipt": {
    "bind": [
      "source_contract_id",
      "request_method",
      "request_url",
      "range_header",
      "response_status",
      "response_sha256",
      "response_byte_count",
      "started_at",
      "completed_at",
      "repository",
      "git_sha",
      "git_ref",
      "workflow_ref",
      "run_id",
      "run_attempt",
      "event_name",
      "predecessor_receipt_sha256"
    ],
    "immutable_subject": "trusted-acquisition.tar",
    "requires_github_artifact_attestation": true
  },
  "schema": "trusted_remote_acquisition_contract.v1",
  "sources": {
    "BINANCE_LISTOBJECTS_V2": {
      "host": "s3-ap-northeast-1.amazonaws.com",
      "max_response_bytes": 8388608,
      "method": "GET",
      "path": "/data.binance.vision",
      "prefix_root": "data/spot/monthly/klines/",
      "required_query": {
        "list-type": "2"
      }
    },
    "COMMONCRAWL_INDEX": {
      "collection_pattern": "^CC-MAIN-[0-9]{4}-[0-9]{2}$",
      "host": "index.commoncrawl.org",
      "max_response_bytes": 8388608,
      "method": "GET",
      "required_query": {
        "output": "json"
      }
    },
    "COMMONCRAWL_WARC_RANGE": {
      "collection_pattern": "^CC-MAIN-[0-9]{4}-[0-9]{2}$",
      "filename_pattern": "^crawl-data/(CC-MAIN-[0-9]{4}-[0-9]{2})/.+/warc/.+\\.warc\\.gz$",
      "host": "data.commoncrawl.org",
      "max_response_bytes": 33554432,
      "method": "GET"
    }
  },
  "trusted_runtime": {
    "event_name": "workflow_dispatch",
    "ref": "refs/heads/main",
    "repository": "rnnyrgs-web/tradingview-ai-crypto"
  }
}
